{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["vite/client", "node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": "..",
    "paths": {
      "@main/*": ["electron/main/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": [
    "main/**/*.ts",
    "preload/**/*.ts",
    "../shared/**/*.ts"
  ]
}
