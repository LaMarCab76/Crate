{
  "manifest": {
    "schemaVersion": 1,
    "id": "nightdesk",
    "name": "Nightdesk",
    "version": "1.0.0",
    "description": "Una interfaz programada con tarjetas de canciones, navegación por pestañas y una pantalla de escucha propia.",
    "kind": "code",
    "base": "glass",
    "capabilities": [
      "library.read",
      "playback.control",
      "queue.control",
      "navigation"
    ],
    "entry": "index.html"
  },
  "files": [
    {
      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>Nightdesk · Crate</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"app.js\" defer></script>\n</head>\n<body>\n  <header><div><small>CRATE / NIGHTDESK</small><h1>Un espacio para escuchar.</h1></div><button id=\"settings\">Preferencias</button></header>\n  <nav aria-label=\"Pantallas\"><button data-screen=\"collection\" aria-current=\"page\">Colección</button><button data-screen=\"listening\">Escuchando</button><button data-screen=\"queue\">Cola</button></nav>\n  <p id=\"status\" role=\"status\" aria-live=\"polite\"></p>\n  <main>\n    <section id=\"collection\"><div class=\"collection-tools\"><label>Buscar<input id=\"search\" type=\"search\" placeholder=\"Canción, artista o álbum\"></label><button id=\"refresh\">Actualizar</button></div><div id=\"cards\" class=\"cards\" aria-label=\"Canciones\"></div><div class=\"pagination\"><button id=\"previous-page\">Página anterior</button><span id=\"page-description\"></span><button id=\"next-page\">Página siguiente</button></div></section>\n    <section id=\"listening\" hidden><div class=\"listening\"><div id=\"cover\" class=\"listening-cover\" aria-hidden=\"true\"></div><div><small>AHORA SUENA</small><h2 id=\"listening-title\">Elegí una canción</h2><p id=\"listening-artist\"></p><p id=\"listening-quality\"></p></div></div></section>\n    <section id=\"queue\" hidden><h2>A continuación</h2><div id=\"queue-list\"></div><button id=\"clear-queue\">Vaciar cola</button></section>\n  </main>\n  <footer><div><strong id=\"track-title\">Tu música está lista</strong><small id=\"track-artist\"></small></div><div class=\"transport\"><button id=\"previous-track\" aria-label=\"Canción anterior\">◀◀</button><button id=\"toggle\" aria-label=\"Reproducir\">▶</button><button id=\"next-track\" aria-label=\"Canción siguiente\">▶▶</button></div><label class=\"progress\"><span id=\"elapsed\">0:00</span><input id=\"seek\" type=\"range\" aria-label=\"Posición de reproducción\" min=\"0\" max=\"1\" value=\"0\"><span id=\"duration\">0:00</span></label><label class=\"volume\">Volumen<input id=\"volume\" type=\"range\" min=\"0\" max=\"1\" step=\"0.02\" value=\"1\"></label></footer>\n</body>\n</html>\n",
      "encoding": "utf8"
    },
    {
      "path": "style.css",
      "content": ":root { color-scheme: dark; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: #e8eeed; background: #111a1d; --accent: #99d7c4; }\n* { box-sizing: border-box; }\nbody { margin: 0; padding: 28px 34px 150px; }\nbutton, input { font: inherit; }\nbutton { background: #203035; border: 1px solid #34484d; color: #e8eeed; border-radius: 8px; padding: 9px 12px; cursor: pointer; }\nbutton:hover { border-color: var(--accent); }\nbutton:disabled { opacity: .35; cursor: default; }\nbutton:focus-visible, input:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }\nheader { display: flex; justify-content: space-between; align-items: center; gap: 20px; }\nsmall { color: #8ca6a7; font-size: 11px; letter-spacing: 1.4px; }\nh1 { font-size: 30px; letter-spacing: -1px; margin: 7px 0 25px; }\nnav { display: flex; gap: 9px; border-bottom: 1px solid #293a3e; padding-bottom: 14px; }\nnav button { background: none; border-color: transparent; }\nnav button[aria-current=page] { background: var(--accent); color: #142e29; }\n#status { color: #a4c5c3; font-size: 12px; min-height: 18px; }\n.collection-tools { display: flex; align-items: end; gap: 15px; margin-bottom: 24px; }\n.collection-tools label { display: flex; flex: 1; flex-direction: column; gap: 7px; font-size: 11px; color: #8ca6a7; }\ninput[type=search] { border: 1px solid #34484d; background: #1a282c; color: #e8eeed; border-radius: 8px; padding: 11px 14px; width: 100%; }\n.cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 15px; }\n.track-card { display: flex; flex-direction: column; border: 1px solid #2b3c41; border-radius: 13px; overflow: hidden; background: #19262a; }\n.track-card-art { aspect-ratio: 1.5; background: linear-gradient(135deg, #36545c, #8da699); display: grid; place-items: center; font-size: 40px; color: #ffffff70; overflow: hidden; }\n.track-card-art img { width: 100%; height: 100%; object-fit: cover; }\n.track-card-body { padding: 13px; display: flex; flex-direction: column; gap: 6px; }\n.track-card h3 { margin: 0; font-size: 14px; }\n.track-card p { margin: 0; font-size: 12px; color: #9fb4b3; }\n.track-card-actions { display: flex; gap: 6px; margin-top: 9px; }\n.track-card-actions button { flex: 1; font-size: 11px; }\n.pagination { display: flex; justify-content: center; align-items: center; gap: 15px; padding: 24px 0; font-size: 12px; }\n.listening { display: grid; grid-template-columns: minmax(160px, 340px) 1fr; gap: 40px; align-items: center; padding: 20px 0; }\n.listening-cover { aspect-ratio: 1; border-radius: 12px; background: linear-gradient(130deg, #355a63, #9ab6a4); overflow: hidden; }\n.listening-cover img { width: 100%; height: 100%; object-fit: cover; }\n.listening h2 { font-size: clamp(24px, 4vw, 45px); margin: 15px 0; }\n.queue-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; padding: 10px 0; border-bottom: 1px solid #293a3e; }\n.queue-row > button:first-child { text-align: left; border: none; background: none; }\nfooter { position: fixed; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: minmax(120px, 1fr) auto minmax(140px, 1.3fr) 110px; gap: 22px; align-items: center; background: #18272bf5; backdrop-filter: blur(18px); border-top: 1px solid #34484d; padding: 17px 28px; }\nfooter strong, footer small { display: block; }\nfooter strong { font-size: 13px; }\nfooter small { font-size: 11px; letter-spacing: 0; margin-top: 5px; }\n.transport { display: flex; gap: 6px; }\n.transport button { min-width: 38px; }\n.progress { display: flex; gap: 8px; align-items: center; font-size: 10px; color: #9fb4b3; }\n.progress input { min-width: 30px; width: 100%; }\n.volume { font-size: 10px; color: #9fb4b3; }\n.volume input { display: block; width: 100%; margin-top: 8px; }\ninput[type=range] { accent-color: var(--accent); }\n[hidden] { display: none !important; }\n@media (max-width: 760px) { body { padding: 22px 20px 170px; } h1 { font-size: 23px; } footer { grid-template-columns: 1fr auto; gap: 14px; padding: 14px 20px; } .listening { gap: 20px; } .progress { grid-column: 1; } .volume { grid-column: 2; } }\n@media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto; } }\n",
      "encoding": "utf8"
    },
    {
      "path": "app.js",
      "content": "/* A dependency-free programmable interface. No Node, Electron or window.api. */\nconst sdk = window.crateInterface\nconst byId = id => document.getElementById(id)\nconst seconds = value => `${Math.floor((value || 0) / 60)}:${String(Math.floor((value || 0) % 60)).padStart(2, '0')}`\nlet offset = 0\nlet total = 0\nlet query = ''\nlet requestVersion = 0\nlet lastQueueKey = ''\nlet lastArtwork = null\nlet lastSnapshot = null\n\nasync function request(method, params) {\n  try { const value = await sdk.request(method, params); byId('status').textContent = ''; return value }\n  catch (error) { byId('status').textContent = error.message || String(error); throw error }\n}\nfunction command(method, params) { void request(method, params).catch(() => {}) }\nfunction artwork(container, url, fallback = '') {\n  container.replaceChildren()\n  if (url && url.startsWith('crate://artwork/')) {\n    const image = document.createElement('img')\n    image.src = url; image.alt = ''; image.addEventListener('error', () => { container.textContent = fallback }, { once: true })\n    container.append(image)\n  } else container.textContent = fallback\n}\n\n// A new component, wholly authored by the package: semantic cards with artwork,\n// track details and independent play / queue actions.\nfunction TrackCard(track) {\n  const article = document.createElement('article'); article.className = 'track-card'\n  const art = document.createElement('div'); art.className = 'track-card-art'; art.setAttribute('aria-hidden', 'true'); artwork(art, track.artworkUrl, track.title.slice(0, 1))\n  const body = document.createElement('div'); body.className = 'track-card-body'\n  const title = document.createElement('h3'); title.textContent = track.title\n  const artist = document.createElement('p'); artist.textContent = track.artist\n  const detail = document.createElement('small'); detail.textContent = `${track.format} · ${seconds(track.duration)}`\n  const actions = document.createElement('div'); actions.className = 'track-card-actions'\n  const play = document.createElement('button'); play.textContent = 'Reproducir'; play.addEventListener('click', () => command('playback.playTrack', { trackId: track.id }))\n  const enqueue = document.createElement('button'); enqueue.textContent = '+ Cola'; enqueue.setAttribute('aria-label', `Agregar ${track.title} a la cola`); enqueue.addEventListener('click', () => command('queue.add', { ids: [track.id] }))\n  actions.append(play, enqueue); body.append(title, artist, detail, actions); article.append(art, body)\n  return article\n}\nasync function loadTracks() {\n  const version = ++requestVersion\n  byId('status').textContent = 'Cargando colección…'\n  try {\n    const page = await request('library.tracks', { offset, limit: 48, query })\n    if (version !== requestVersion) return\n    total = page.total\n    byId('cards').replaceChildren(...page.items.map(TrackCard))\n    if (!page.items.length) byId('cards').textContent = query ? 'No hay coincidencias. Probá otra búsqueda.' : 'Tu colección está vacía. Agregá una carpeta desde Preferencias.'\n    byId('page-description').textContent = total ? `${offset + 1}–${Math.min(offset + page.items.length, total)} de ${total}` : '0 canciones'\n    byId('previous-page').disabled = offset === 0\n    byId('next-page').disabled = offset + 48 >= total\n  } catch { /* visible request error */ }\n}\nfunction renderQueue(state) {\n  const key = JSON.stringify([state.queue.currentIndex, state.queue.tracks.map(track => [track.id, track.title, track.artist])])\n  if (lastQueueKey === key) return\n  lastQueueKey = key\n  const rows = state.queue.tracks.map((track, index) => {\n    const row = document.createElement('div'); row.className = 'queue-row'\n    const play = document.createElement('button'); play.textContent = `${index === state.queue.currentIndex ? '▶ ' : ''}${track.title} · ${track.artist}`; play.addEventListener('click', () => command('queue.play', { index }))\n    const remove = document.createElement('button'); remove.textContent = 'Quitar'; remove.setAttribute('aria-label', `Quitar ${track.title} de la cola`); remove.addEventListener('click', () => command('queue.remove', { index }))\n    row.append(play, remove); return row\n  })\n  byId('queue-list').replaceChildren(...rows)\n  if (!rows.length) byId('queue-list').textContent = 'La cola está vacía.'\n}\nfunction renderState(state) {\n  if (!state?.playback || !state?.queue) return\n  lastSnapshot = state\n  const { playback } = state\n  const track = playback.currentTrack\n  byId('track-title').textContent = track?.title || 'Tu música está lista'\n  byId('track-artist').textContent = track?.artist || ''\n  byId('listening-title').textContent = track?.title || 'Elegí una canción'\n  byId('listening-artist').textContent = track?.artist || ''\n  byId('listening-quality').textContent = track ? `${track.album} · ${track.format} ${track.quality}` : ''\n  const artworkKey = `${track?.id}:${track?.artworkUrl}`\n  if (lastArtwork !== artworkKey) { lastArtwork = artworkKey; artwork(byId('cover'), track?.artworkUrl) }\n  byId('toggle').textContent = playback.status === 'playing' ? 'Ⅱ' : '▶'\n  byId('toggle').setAttribute('aria-label', playback.status === 'playing' ? 'Pausar' : 'Reproducir')\n  byId('seek').max = playback.durationSec || 1; if (document.activeElement !== byId('seek')) byId('seek').value = playback.positionSec || 0; byId('seek').disabled = !track\n  byId('elapsed').textContent = seconds(playback.positionSec); byId('duration').textContent = seconds(playback.durationSec)\n  if (document.activeElement !== byId('volume')) byId('volume').value = playback.volume\n  renderQueue(state)\n}\ndocument.querySelectorAll('[data-screen]').forEach(button => button.addEventListener('click', () => {\n  const id = button.dataset.screen\n  for (const section of document.querySelectorAll('main > section')) section.hidden = section.id !== id\n  for (const item of document.querySelectorAll('[data-screen]')) item.removeAttribute('aria-current')\n  button.setAttribute('aria-current', 'page')\n  if (id === 'queue' && lastSnapshot) renderQueue(lastSnapshot)\n}))\nbyId('settings').addEventListener('click', () => command('navigation.openSettings'))\nbyId('toggle').addEventListener('click', () => command('playback.toggle'))\nbyId('previous-track').addEventListener('click', () => command('playback.previous'))\nbyId('next-track').addEventListener('click', () => command('playback.next'))\nbyId('seek').addEventListener('change', event => command('playback.seek', { positionSec: Number(event.target.value) }))\nbyId('volume').addEventListener('change', event => command('playback.volume', { volume: Number(event.target.value) }))\nbyId('clear-queue').addEventListener('click', () => command('queue.clear'))\nbyId('refresh').addEventListener('click', () => void loadTracks())\nbyId('previous-page').addEventListener('click', () => { offset = Math.max(0, offset - 48); void loadTracks() })\nbyId('next-page').addEventListener('click', () => { if (offset + 48 < total) { offset += 48; void loadTracks() } })\nlet searchTimer\nbyId('search').addEventListener('input', event => { clearTimeout(searchTimer); query = event.target.value; offset = 0; searchTimer = setTimeout(() => void loadTracks(), 250) })\nconst unsubscribe = sdk.onState(renderState)\nwindow.addEventListener('pagehide', () => { unsubscribe(); clearTimeout(searchTimer) }, { once: true })\nvoid loadTracks()\n",
      "encoding": "utf8"
    }
  ]
}
