{
  "name": "crate",
  "version": "0.5.1",
  "description": "Audiophile music library and player",
  "main": "out/main/index.js",
  "author": "Lautaro Caballero",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "typecheck:node": "tsc --noEmit -p electron/tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p electron/tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^40.10.2",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.5"
  },
  "dependencies": {
    "@azure/msal-node": "^5.2.2",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^5.0.0",
    "electron-updater": "6.8.7",
    "extract-zip": "^2.0.1",
    "koffi": "^3.0.2",
    "music-metadata": "^11.12.3",
    "node-taglib-sharp": "^6.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.0",
    "zustand": "^5.0.13"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
