{
  "name": "crate",
  "version": "0.6.6",
  "description": "Audiophile music library and player",
  "main": "out/main/index.js",
  "author": "Lautaro Caballero",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LaMarCab76/Crate.git"
  },
  "homepage": "https://github.com/LaMarCab76/Crate#readme",
  "bugs": {
    "url": "https://github.com/LaMarCab76/Crate/issues"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "node --test",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "fetch:bass": "node scripts/fetch-bass.mjs",
    "verify:bass": "node scripts/verify-bass.mjs",
    "build:crate-audio": "node scripts/build-crate-audio.mjs",
    "fetch:crate-audio": "node scripts/fetch-crate-audio.mjs",
    "verify:crate-audio": "node scripts/verify-crate-audio.mjs",
    "fetch:chromaprint": "node scripts/fetch-chromaprint.mjs",
    "build:chromaprint": "node scripts/build-chromaprint.mjs",
    "verify:chromaprint": "node scripts/verify-chromaprint.mjs",
    "smoke:chromaprint-pipeline": "node scripts/smoke-chromaprint-pipeline.mjs",
    "fetch:native": "node scripts/fetch-native.mjs",
    "verify:native": "node scripts/verify-native.mjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "typecheck:node": "tsc --noEmit -p electron/tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p electron/tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "npm run verify:native && electron-vite build && electron-builder --publish never",
    "dist:mac": "npm run verify:native -- --platform=darwin --arch=universal && electron-vite build && electron-builder --mac --publish never",
    "dist:win": "npm run verify:native -- --platform=win32 --arch=x64 && electron-vite build && electron-builder --win --publish never",
    "dist:linux": "npm run verify:native -- --platform=linux --arch=x64 && electron-vite build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^40.10.2",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.5"
  },
  "dependencies": {
    "@azure/msal-node": "^5.2.2",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^5.0.0",
    "electron-updater": "6.8.7",
    "extract-zip": "^2.0.1",
    "koffi": "^3.0.2",
    "music-metadata": "^11.12.3",
    "node-taglib-sharp": "^6.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.0",
    "zustand": "^5.0.13"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
